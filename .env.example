# The Void AI Orchestration System — Environment Template
# Version: 2.2.0 | ZQM Computing LLC
#
# IMPORTANT: Copy this file to `.env` and change ALL secrets before deployment.
# Do NOT use the defaults in production. They are placeholders only.

# Application
APP_NAME=The Void
APP_VERSION=2.2.0
ENVIRONMENT=development
APP_DEBUG=false

# Security — REQUIRED: generate a strong secret before deployment
# Example OpenSSL command:
#   openssl rand -hex 32
SECRET_KEY=insecure-default-rotate-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin credentials — REQUIRED: set a strong password
ZQM_ADMIN_PASSWORD=

# Internal service keys — REQUIRED: generate unique keys per service
ZQM_INTERNAL_KEY=
ZQM_GARDEN_SERVICE_KEY=
ZQM_FLATSPACE_SERVICE_KEY=
ZQM_OBSERVABILITY_SERVICE_KEY=

# Database
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# AI Providers
DEFAULT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search
MEILISEARCH_URL=http://127.0.0.1:7701
MEILISEARCH_MASTER_KEY=
MEILISEARCH_DEFAULT_INDEX=flatspace
SEARXNG_URL=http://127.0.0.1:8080

# Customer/Branding
CUSTOMER_NAME=Customer
BRAND_COMPANY_NAME=Customer
BRAND_SUPPORT_EMAIL=zqmcomputing@gmail.com
BRAND_PORTAL_URL=http://localhost:8808/docs

# CORS — restrict to your domains in production
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Optional billing adapter: stub, stripe, paypal
BILLING_ADAPTER=stub
