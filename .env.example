# The Void — Environment Template
# Copy to .env and fill in real values.
# cp .env.example .env

# ── Application ───────────────────────────────────────────────────────────
APP_NAME="The Void"
APP_VERSION="2.1.4"
ENVIRONMENT="development"
APP_DEBUG=true

# ── Security / JWT ────────────────────────────────────────────────────────
SECRET_KEY="changeme-please-generate-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ZQM_INTERNAL_KEY=""
GITHUB_WEBHOOK_SECRET=""
ZQM_ADMIN_PASSWORD=""
ZQM_GARDEN_SERVICE_KEY=""
ZQM_FLATSPACE_SERVICE_KEY=""
ZQM_OBSERVABILITY_SERVICE_KEY=""
OLLAMA_API_KEY=""

# ── Redis / Cache ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
REDIS_PASSWORD=""
CACHE_TTL_SECONDS=3600
VOID_CACHE_MAX_SIZE=512
VOID_CACHE_STRATEGY="LRU"

# ── ZQM Garden ──────────────────────────────────────────────────────────
GARDEN_ENDPOINT="http://192.168.1.228:8808/api/garden/coordinate"
GARDEN_NODE_0="192.168.1.228"
GARDEN_NODE_1="192.168.1.224"
GARDEN_NODE_2="192.168.1.31"
GARDEN_NODE_3="192.168.1.64"
GARDEN_NODE_4="192.168.1.144"
GARDEN_TIMEOUT=30
GARDEN_RETRIES=3

# ── ZQM FLATSPACE ───────────────────────────────────────────────────────
FLATSPACE_ENDPOINT="http://192.168.1.228:8808/api/flatspace/store"
FLATSPACE_POLLEN_STORE="http://192.168.1.228:8808/api/flatspace/pollen"
FLATSPACE_BIT_GARDEN="http://192.168.1.228:8808/api/flatspace/bitgarden"
FLATSPACE_WAX_CELL="http://192.168.1.228:8808/api/flatspace/waxcell"

# ── ZQM Observability ───────────────────────────────────────────────────
OBSERVABILITY_ENDPOINT="http://192.168.1.228:8808/api/observability/metrics"
OBSERVABILITY_ENABLED=false
METRICS_PORT=9091

# ── ZQM Network ─────────────────────────────────────────────────────────
NETWORK_ENDPOINT="http://192.168.1.228:8808/api/network"

# ── ZQM Eden ────────────────────────────────────────────────────────────
EDEN_ENDPOINT="http://192.168.1.228:8443/api/auth"
EDEN_ENABLED=false

# ── GitHub Integration ──────────────────────────────────────────────────
GITHUB_REPO_OWNER="zqm-computing"
GITHUB_REPO_NAME="zqm-ai-master"
GITHUB_WEBHOOK_SECRET=""
GITHUB_TOKEN=""

# ── AI Providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-3-5-sonnet-20241022"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5:3b"
DEFAULT_AI_PROVIDER="ollama"

# ── Cognitive Processing ────────────────────────────────────────────────
DEFAULT_COGNITIVE_LEVEL="advanced"
MAX_CONCURRENT_TASKS=20
TASK_TIMEOUT_SECONDS=300

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE="logs/zqm_ai.log"

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS="*"
CORS_ALLOW_CREDENTIALS=true
